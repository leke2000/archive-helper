def _pending_name(label: str, sources: list[str]) -> str:
    """给"密码待补"的包起个干净的文件夹名。

    从源文件名一层层剥掉归档/伪装尾巴：
    `339.艾西Aiwest.7z.001.pdf` -> `339.艾西Aiwest`，
    `猫和老鼠1.mp4` -> `猫和老鼠1`，`ba469.7z.001` -> `ba469`。
    """
    raw = os.path.basename(sources[0]) if sources else ""
    if not raw:
        raw = os.path.basename(label.replace(os.sep, "_")) or "未命名"
        if "（" in raw:
            raw = raw.split("（")[0]
    name = raw
    while True:
        stripped = _TAIL_RE.sub("", name, count=1)
        if stripped == name or not stripped:
            break
        name = stripped
    if not name:
        name = os.path.splitext(raw)[0] or raw
    name = re.sub(r'[\\/:\*\?"<>|]', "_", name).strip(" .")
    return name or "未命名"


def _under_pending(path: str) -> bool:
    """这个路径是否已经在某个 _待补密码 目录下面。"""
    p = os.path.abspath(path)
    while True:
        p, name = os.path.split(p)
        if not name:
            return False
        if name == PENDING_DIR:
            return True


def move_to_pending(inbox: str, label: str, sources: list[str]) -> str:
    """密码未知的源包挪进 <收件箱>\\_待补密码\\<包名>\\，返回落点。

    已经在 _待补密码 里的（例如直接跑那个目录）不再套一层，返回空串。
    """
    if any(_under_pending(s) for s in sources):
        return ""                       # 已经在待补目录里，别再套一层
    root = os.path.join(inbox, PENDING_DIR)
    name = _pending_name(label, sources)
    dest = os.path.join(root, name)
    n = 2
    while os.path.exists(dest):
        dest = os.path.join(root, f"{name}-{n}")
        n += 1
    os.makedirs(dest, exist_ok=True)
    for s in dict.fromkeys(sources):
        if not os.path.exists(s):
            continue
        target = os.path.join(dest, os.path.basename(s))
        try:
            os.replace(s, target)       # 同盘：瞬间改名
        except OSError:
            try:
                shutil.move(s, target)
            except (OSError, shutil.Error) as exc:
                log(f"   !! 移不动 {s}: {exc}")
    return dest


def write_pending_list(inbox: str) -> str:
    """把 _待补密码 里的包列成清单，方便随时看还缺哪些密码。"""
    root = os.path.join(inbox, PENDING_DIR)
    if not os.path.isdir(root):
        # 收件箱本身就是 _待补密码 目录时，就写在这里
        if os.path.basename(os.path.abspath(inbox)) == PENDING_DIR:
            root = os.path.abspath(inbox)
        else:
            return ""
    rows = []
    for name in sorted(os.listdir(root)):
        d = os.path.join(root, name)
        if not os.path.isdir(d):
            continue
        files = [f for f in os.listdir(d) if f != PENDING_LIST]
        total = 0
        for f in files:
            try:
                total += os.path.getsize(os.path.join(d, f))
            except OSError:
                pass
        rows.append((name, len(files), total))
    path = os.path.join(root, PENDING_LIST)
    try:
        with open(path, "w", encoding="utf-8") as f:
            f.write("# 解压密码未知的包（补上密码后，可用:\n")
            f.write(f"#   收件箱.py \"{root}\" <归档目录>\n")
            f.write("# 重新处理）\n")
            f.write(f"# 更新于 {time.strftime('%Y-%m-%d %H:%M')}\n\n")
            f.write(f"{'包名':<40} {'文件数':>6} {'体积':>10}\n")
            f.write("-" * 60 + "\n")
            for name, cnt, total in rows:
                f.write(f"{name:<40} {cnt:>6} {human(total):>10}\n")
    except OSError as exc:
        log(f"  !! 清单写入失败: {exc}")
    return path


def main() -> int:
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    delete_source = "--delete-source" in sys.argv
