def parse_part(name: str):
    """解析文件名 -> (base, volume_no)。

    volume_no 为 None 表示名字里没有卷号（可能是首卷，也可能是单文件包）。
      '218.花柒Hana.7z.7z.001.pdf' -> ('218.花柒Hana.7z.7z', 1)
      '26.7z.001删'                -> ('26.7z', 1)
      'rizunya.7z.002'             -> ('rizunya.7z', 2)
      '26.7z'                      -> ('26.7z', None)
      'video.mp4'                  -> (None, None)
    """
    m = _PART_RE.match(name)
    if not m:
        return None, None
    base = m.group("base")
    vol = m.group("vol")
    return base, (int(vol[1:]) if vol else None)


_SAMPLE_MIN = 8 << 20          # 小于这个尺寸就全读
_SAMPLE_PIECE = 1 << 20        # 抽样时每段读 1MB


def _digest(path: str, chunk: int = 8 << 20) -> str:
    """内容指纹，用于去重。

    大于 8MB 的文件只抽 头/中/尾 各 1MB + 文件大小 来比对：重复下载的副本
    是逐字节相同的，抽样足够分辨；而整读一个 3GB 的包要十几秒，抽样只要
    几十毫秒。同尺寸、不同内容、又恰好三处抽样全撞上的概率可以忽略。
    """
    sz = os.path.getsize(path)
    h = hashlib.md5()
    h.update(str(sz).encode())
    with open(path, "rb") as f:
        if sz <= _SAMPLE_MIN:
            while True:
                b = f.read(chunk)
                if not b:
                    break
                h.update(b)
            return h.hexdigest()
        for off in (0, max(0, sz // 2 - _SAMPLE_PIECE // 2), sz - _SAMPLE_PIECE):
            f.seek(off)
            h.update(f.read(_SAMPLE_PIECE))
    return h.hexdigest()


def _dedup(paths: list[str]) -> tuple[list[str], list[tuple[str, str]]]:
    """按内容去重，返回 (保留的路径, [(被丢弃的, 保留的)])。"""
    keep: list[str] = []
    dups: list[tuple[str, str]] = []
    seen: dict[tuple[int, str], str] = {}
    for p in paths:
        try:
            sz = os.path.getsize(p)
            dg = _digest(p)
        except OSError:
            continue
        key = (sz, dg)
        if key in seen:
            dups.append((p, seen[key]))
        else:
            seen[key] = p
            keep.append(p)
    return keep, dups


def _link_into(dirpath: str, src: str, canonical: str) -> str:
    """在 dirpath 下建一个名为 canonical 的入口指向 src。

    优先硬链接（同盘瞬时完成、不占空间），失败则退回复制。
    """
    dst = os.path.join(dirpath, canonical)
    if os.path.exists(dst):
        try:
            if os.path.samefile(dst, src):
                return dst
        except OSError:
            pass
        try:
            os.chmod(dst, 0o666)
            os.remove(dst)
        except OSError:
            pass
    try:
        os.link(src, dst)
    except OSError:
        shutil.copy2(src, dst)
    return dst


def collect(inbox: str):
    """扫描收件箱，返回 [(标签, 待打开路径, 源文件列表)]。

    分卷会跨文件夹归组，并在暂存区建一套规范命名的入口，这样即使
    首卷丢了卷号、卷号后面带杂字、各卷分散在不同目录，7-Zip 也能解。
    """
    parts: dict[str, dict] = {}      # base -> {vol_or_None: [paths]}
    disguised: list[str] = []        # 伪装成媒体文件的包
    sniffed: list[tuple[str, str]] = []   # (源路径, 补齐后的名字)
    zitems: list[tuple[str, str, list[str]]] = []   # 分卷 zip（x.z01…x.zip）

    for root, dirs, files in os.walk(inbox):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        for name in sorted(files):
            if name.endswith(".qkdownloading"):
                continue
            p = os.path.join(root, name)

            # --- 没下完 / 分卷不齐的预检：先说清楚，别白跑一遍 CRC ---
            busy = _still_downloading(p)
            if busy:
                log(f"  (跳过还在下载的 {name}，同目录有 {busy})")
                continue
            low = name.lower()

            # 工具自己产生的中间文件不要当成包（_restored1.bin 这种）
            if low.startswith("_restored") or low.endswith((".qkdownloading",)):
                continue
            if root.split(os.sep)[-1].startswith(("_work", "_vols_", "_parts",
                                                  "_staging", "_inbox", "_kept")):
                continue

            # 分卷 zip（x.z01 / x.z02 … / x.zip）：能解，入口用收尾卷 x.zip，
            # 这样 7-Zip 会自己把 z01/z02 一起带上；缺收尾卷就等下载
            if re.search(r"\.z\d\d$", low):
                last = os.path.join(root, re.sub(r"\.z\d\d$", ".zip", name))
                if not os.path.exists(last):
                    log(f"  !! {name} 是分卷 zip 的一卷，缺收尾卷 "
                        f"{os.path.basename(last)}，凑齐后会自动处理")
                    continue
                parts = [os.path.join(root, f) for f in sorted(os.listdir(root))
                         if f == os.path.basename(last)
                         or re.fullmatch(re.escape(os.path.basename(last)[:-4])
                                         + r"\.z\d\d", f, re.IGNORECASE)]
                zitems.append((f"{os.path.basename(last)[:-4]}（分卷 zip {len(parts)} 卷）",
                               last, parts))
                continue

            base, vol = parse_part(name)
            # 只有 .001、没有 .002，末尾又没有 zip 目录 -> 缺卷或没下完。
            # 7z 不这样判：它的头里写着整个流的长度，由解压流程报"还差多少"更准。
            if (vol is not None and low.endswith(".zip.001")
                    and not os.path.exists(os.path.join(root, name[:-4] + ".002"))
                    and not _zip_has_eocd(p)):
                log(f"  !! {name} 末尾没有 zip 目录，像是分卷的一部分或没下完，"
                    "先跳过（凑齐后会自动处理）")
                continue
            if base is None:
                ext = os.path.splitext(name)[1].lower()
                # 名字不像压缩包：可能是尾部反转 / 追加型伪装
                if ext in _MEDIA_EXT:
                    try:
                        if detect(p).kind in ("tail_reversed", "appended"):
                            disguised.append(p)
                            continue
                    except Exception:
                        pass
                # 扩展名不认识（含完全没有扩展名）：按文件头猜
                # 例：课件196 == gzip，617 == 7z
                if ext not in _KNOWN_EXT:
                    kind = sniff_container(p)
                    if kind:
                        sniffed.append((p, name + CONTAINER_EXT[kind]))
                continue
            parts.setdefault(base, {}).setdefault(vol, []).append(p)

    items: list[tuple[str, str, list[str]]] = []
    links_dir = os.path.join(STAGING, "_parts")

    # 无扩展名 / 未知扩展名的包：建一个带正确后缀的入口再解
    if sniffed:
        os.makedirs(links_dir, exist_ok=True)
    for src, target_name in sniffed:
        if target_name.lower().endswith(".7z") and is_incomplete_7z(src):
            # 缺后续分卷的 7z 首卷，补成 .001 让 7-Zip 按分卷去找
            target_name += ".001"
        try:
            entry = _link_into(links_dir, src, target_name)
        except Exception as exc:
            log(f"  !! {os.path.basename(src)} 建立入口失败: {exc}")
            continue
        items.append((f"{os.path.relpath(src, inbox)}（按文件头识别为 {os.path.splitext(target_name)[1].lstrip('.')}）",
                      entry, [src]))

    for base, volmap in sorted(parts.items()):
        numbered = sorted(v for v in volmap if v)
        all_paths = [p for lst in volmap.values() for p in lst]

        # 没有第二卷及以上 -> 当成独立包逐个处理
        if not any(v >= 2 for v in numbered):
            keep, dups = _dedup(all_paths)
            if dups:
                log(f"  (跳过 {len(dups)} 个重复副本)")
            for p in keep:
                items.append((os.path.relpath(p, inbox), p, [p]))
            continue

        # 分卷：确定每一卷用哪个文件
        maxv = max(numbered)
        chosen: dict[int, str] = {}
        # 第一卷：优先带 .001 的，没有就用无卷号的那个
        first_pool = volmap.get(1) or volmap.get(None) or []
        if first_pool:
            keep, _ = _dedup(first_pool)
            if keep:
                chosen[1] = keep[0]
        for v in numbered:
            if v < 2:
                continue
            keep, _ = _dedup(volmap[v])
            if keep:
                chosen[v] = keep[0]

        missing = [v for v in range(1, maxv + 1) if v not in chosen]
        if missing:
            log(f"  !! {base} 缺少分卷 {missing}，跳过")
            continue

        os.makedirs(links_dir, exist_ok=True)
        try:
            entries = [_link_into(links_dir, chosen[v], f"{base}.{v:03d}")
                       for v in sorted(chosen)]
        except Exception as exc:
            log(f"  !! {base} 建立分卷入口失败: {exc}")
            continue
        items.append((f"{base}（{len(chosen)} 卷）", entries[0], all_paths))

    # 分卷 zip
    items.extend(zitems)

    # 伪装成媒体文件的包
    for fp in disguised:
        items.append((os.path.relpath(fp, inbox), fp, [fp]))

    return _drop_duplicates(items)


def _drop_duplicates(items: list) -> list:
    """同一内容的多个副本只保留一个（浏览器重复下载会产生 "xxx(1)"）。"""
    by_size: dict[int, list] = {}
    for it in items:
        try:
            sz = os.path.getsize(it[1])
        except OSError:
            continue
        by_size.setdefault(sz, []).append(it)

    keep: list = []
    dups: list = []
    for sz, group in by_size.items():
        if len(group) == 1:
            keep.extend(group)
            continue
        seen: dict[str, str] = {}
        for it in group:
            try:
                dg = _digest(it[1])
            except OSError:
                keep.append(it)
                continue
            if dg in seen:
                dups.append((it[0], seen[dg]))
            else:
                seen[dg] = it[0]
                keep.append(it)

    if dups:
        log(f"发现 {len(dups)} 个重复副本，已跳过：")
        for dup, orig in dups:
            log(f"   {dup}  ==  {orig}")
    return keep


