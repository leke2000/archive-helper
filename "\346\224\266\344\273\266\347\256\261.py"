    ".txt", ".url", ".lnk", ".pptx", ".docx", ".xlsx", ".doc", ".xls", ".ppt",
    ".exe", ".dll", ".sys", ".msi", ".apk", ".ipa", ".jar", ".py", ".js", ".json",
