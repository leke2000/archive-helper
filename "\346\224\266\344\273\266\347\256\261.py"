def _zip_has_eocd(path: str) -> bool:
    """zip 的目录（EOCD）永远在文件末尾且不加密；末尾 64KB 里找不到，
    基本就是分卷的一部分或者没下完。"""
    try:
        sz = os.path.getsize(path)
        with open(path, "rb") as f:
            f.seek(max(0, sz - 65536))
            return b"PK" in f.read()
    except OSError:
        return False


def _still_downloading(path: str) -> str:
    """同目录有没有同名（或同前缀）的 .qkdownloading 陪跑 —— 有就说明还在下。"""
    d = os.path.dirname(os.path.abspath(path))
    stem = os.path.splitext(os.path.basename(path))[0]
    try:
        for n in os.listdir(d):
            if n.endswith(".qkdownloading") and (stem[:12] in n or n.startswith(stem[:12])):
                return n
    except OSError:
        pass
    return ""


def log(msg: str) -> None:
    print(msg, flush=True)


def human(n: float) -> str:
    for u in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return f"{n:.0f}{u}"
        n /= 1024
    return f"{n:.0f}PB"


